# Python virtual environment
venv/
.venv/
env/

# Python cache & testing
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Keep .gitkeep files everywhere
!.gitkeep

# Raw data images and runtime snapshots
data/raw/*
!data/raw/**/.gitkeep
data/snapshots/*
!data/snapshots/.gitkeep

# CSV files except data/features.csv
*.csv
!data/features.csv

# Internal backup
.backup_future_phases/

# Backend runtime data and build artifacts
backend/data/
backend/uploads/
target/
**/target/

# Frontend dependencies, dist, and local environment
frontend/node_modules/
frontend/dist/
dist/
**/dist/
frontend/.env
frontend/.env.local
.env
