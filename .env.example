# ==============================================================================
# QualiScan Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholder values before running Docker Compose:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DB_NAME=qualiscan
DB_USER=qualiscan
DB_PASSWORD=qualiscan_secure_db_password_change_me

# ------------------------------------------------------------------------------
# Spring Security & JWT Configuration
# Requirement: Must be a cryptographically strong secret (>= 32 characters for HMAC-SHA256)
# ------------------------------------------------------------------------------
JWT_SECRET=QualiScan-Production-Super-Secret-Key-Must-Be-At-Least-32-Bytes!
JWT_EXPIRATION_MINUTES=120

# ------------------------------------------------------------------------------
# Frontend Build Configuration
# Base URL consumed by Vite during static asset compilation
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# Host CV Service Edge Client Configuration (Host -> Docker Backend)
# ------------------------------------------------------------------------------
QUALISCAN_BASE_URL=http://localhost:8080
QUALISCAN_USER=admin
QUALISCAN_PASSWORD=Admin@123
# Device API Key generated once at initial startup or via POST /api/lines/{id}/rotate-key
QUALISCAN_API_KEY=
